# Copy to .env. Replace both secrets before starting.
AI_MODE=demo
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
POSTGRES_USER=travel
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=travel
DATABASE_URL=postgresql://travel:replace-with-a-random-database-password@localhost:5432/travel
PORT=3000
# Direct host API=0; Docker Compose sets its trusted proxy topology automatically.
TRUST_PROXY_HOPS=0
WEB_PORT=8080
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENTRIPMAP_API_KEY=
