{
  "name": "travel-ai",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @travel/shared build && pnpm -r --parallel --filter @travel/api --filter @travel/web dev",
    "build": "pnpm --filter @travel/shared build && pnpm --filter @travel/api build && pnpm --filter @travel/web build",
    "typecheck": "pnpm --filter @travel/shared build && pnpm -r typecheck",
    "test": "vitest run --configLoader runner",
    "test:integration": "vitest run --configLoader runner --config vitest.integration.config.ts",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema database/schema.prisma",
    "db:dev": "prisma migrate dev --schema database/schema.prisma",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.19.0",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "prisma": "6.19.0"
  }
}
